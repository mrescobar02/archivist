# ─── Database (Supabase Session Pooler — IPv4 compatible) ────────────────────
# Use the Session Pooler URL from Supabase > Connect > Session Pooler
# Encode special chars in password: @ → %40
DATABASE_URL=postgresql+psycopg2://postgres.PROJECT_REF:PASSWORD@aws-1-us-east-2.pooler.supabase.com:5432/postgres

# ─── AI (Groq) ───────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
GROQ_MAX_TOKENS=1024

# ─── Auth (Supabase) ─────────────────────────────────────────────────────────
SUPABASE_URL=https://PROJECT_REF.supabase.co

# ─── Stripe (leave empty → all users get Pro, beta mode) ─────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...

# ─── Server ──────────────────────────────────────────────────────────────────
BACKEND_PORT=8000

# ─── CORS (comma-separated, no trailing slash) ────────────────────────────────
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# ─── File uploads ────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads/receipts
